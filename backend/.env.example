# Backend Environment Variables Template
# Copy this file to .env in your backend directory or set in your deployment platform

# Server Port
PORT=5000

# Node Environment
NODE_ENV=production

# Authorized Administrator Email
ADMIN_EMAIL=shakthiganeshn.it25@bitsathy.ac.in

# Authorized Administrator Password (DO NOT hardcode in source code or commit to GitHub)
ADMIN_PASSWORD=change_this_to_your_secure_admin_password

# Session Secret Key for Token Signatures / Encryption
SESSION_SECRET=generate_a_random_32_char_secret_key_here

# Allowed Frontend Origins (Comma-separated for CORS in production)
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:3000
